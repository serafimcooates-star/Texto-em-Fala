    "express": "^5.2.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.1",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
